# Obsidian Auto-Linker Configuration

# Path to your Obsidian vault (required)
OBSIDIAN_VAULT_PATH=/home/username/Documents/Obsidian Vault

# Folders to ignore (comma-separated list of root folder names)
# These folders will be completely skipped during scanning
IGNORE_FOLDERS=Folder1,Folder2

# Default similarity threshold (0.0-1.0)
# Higher = more strict matching
SIMILARITY_THRESHOLD=0.15

# Maximum links to add per note
MAX_LINKS_PER_NOTE=20

# Minimum word length for matching (3-5 recommended)
MIN_WORD_LENGTH=4
